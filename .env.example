# Spotify Web API Credentials (Development Mode)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_REFRESH_TOKEN=

# Google Cloud Storage (Catalog Tracks Parquet)
GCS_BUCKET_NAME=your_gcs_bucket_name_here
GCS_TRACKS_FILE_PATH=Songs/songs_final.parquet

# Path to GCP service account JSON key file (optional if using gcloud auth application-default login)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
